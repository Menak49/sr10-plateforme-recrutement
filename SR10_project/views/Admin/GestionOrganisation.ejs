<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestion des demandes pour devenir recruteur</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { title: 'Organisations' }) %>

    <div class="container mt-5">
      <h2 class="mb-4 text-center">Organisations enregistrées</h2>

      <form method="get" action="/ListeOrganisation" class="mb-4 text-center">
        <div class="input-group mt-3 mb-3 shadow-sm">
          <input
            type="text"
            class="form-control"
            placeholder="Rechercher un utilisateur..."
          />
          <button type="submit" class="btn btn-dark">🔍</button>
        </div>
      </form>

      <div class="row">
        <% organisations.forEach(function(org) { %>
        <div class="col-md-4">
          <div class="card mb-4 shadow-sm">
            <div class="card-body">
              <h5 class="card-title"><%= org.nom %></h5>

              <% if (org.statut === 'StandBy') { %>
              <p class="card-text">
                <strong>Statut :</strong>
                <span class="text-warning">En attente</span>
              </p>
              <p class="card-text"><strong>SIREN :</strong> <%= org.siren %></p>
              <p class="card-text">
                <strong>Localisation :</strong> <%= org.localisation %>
              </p>
              <p class="card-text"><strong>Type :</strong> <%= org.type %></p>

              <div class="d-flex justify-content-between mt-3">
                  <input type="hidden"
                   name="siren"
                   />
                  <button type="submit" class="btn btn-outline-success"
                  value="<%= org.siren %>"
                  data-bs-toggle="modal"
                  data-bs-target="#validModalOrganisation-<%= org.siren %>">Valider</button>
                  <input type="hidden" name="siren" value="<%= org.siren %>" />
                  <button type="submit" class="btn btn-outline-danger"
                  value="<%= org.siren %>"
                  data-bs-toggle="modal"
                  data-bs-target="#deleteModalOrganisation-<%= org.siren %>">Refuser</button>
                  <%- include('../partials/Confirmation', { 
                    modalId: 'deleteModalOrganisation-' + org.siren, 
                    message: 'Êtes-vous sûr de vouloir refuser cette organisation ?', 
                    action: '/RefuserOrganisation/'+ org.siren, 
                    siren: org.siren 
                  }) %>
                  <%- include('../partials/Confirmation', { 
                    modalId: 'validModalOrganisation-' + org.siren, 
                    message: 'Êtes-vous sûr de vouloir valider cette organisation ?', 
                    action: '/ValiderOrganisation/'+ org.siren,
                    siren: org.siren 
                  }) %>
                
              </div>
              <% } else { %>
              <p class="card-text">
                <strong>Statut :</strong> <%= org.statut %>
              </p>
              <p class="card-text"><strong>SIREN :</strong> <%= org.siren %></p>
              <p class="card-text">
                <strong>Localisation :</strong> <%= org.localisation %>
              </p>
              <p class="card-text"><strong>Type :</strong> <%= org.type %></p>
              <% } %>
            </div>
          </div>
        </div>
        <% }); %>
      </div>

      <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
          <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= i === currentPage ? 'active' : '' %>">
            <a
              class="page-link"
              href="/ListeOrganisation?page=<%= i %>&search=<%= searchTerm %>"
              ><%= i %></a
            >
          </li>
          <% } %>
        </ul>
      </nav>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
