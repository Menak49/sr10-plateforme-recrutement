<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestion des demandes pour devenir recruteur</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-4">
      <h2 class="fw-bold">GESTION DES DEMANDES POUR DEVENIR RECRUTEUR</h2>

      <div class="d-flex align-items-center text-muted mb-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          fill="currentColor"
          class="bi bi-info-circle me-2"
          viewBox="0 0 16 16"
        >
          <path
            d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16z"
          />
          <path
            d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 .875-.252 1.02-.598l.088-.416c.066-.308.118-.437.288-.469l.451-.083.082-.38-1.293-.287.738-3.468zM8 5.5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1z"
          />
        </svg>
        <small
          >Candidats souhaitant devenir recruteur. Validez ou refusez les
          demandes.</small
        >
      </div>

      <form action="/gestionRecruteurDemandes" method="GET">
        <div class="input-group mt-3 mb-3 shadow-sm">
          <input
            type="text"
            class="form-control"
            name="search"
            placeholder="Rechercher une demande..."
            value="<%= searchTerm %>"
          />
          <button type="submit" class="btn btn-dark">🔍</button>
        </div>
      </form>

      <div class="mb-3">
        <div class="card">
          <div class="card-body">
            <h6 class="fw-bold">Clé</h6>
            <div class="d-flex gap-2">
              <span class="badge bg-dark py-2 px-3">En attente</span>
              <span class="badge bg-success py-2 px-3">Validé</span>
            </div>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <% demandes.forEach(demande => { %>
        <div class="col-md-4 mb-3">
          <div class="card border shadow-sm h-100">
            <div class="card-body">
              <h5 class="fw-bold mb-0"><%= demande.nom %></h5>
              <p class="text-muted"><%= demande.email %></p>
              <p class="small mb-2">Message: <%= demande.message %></p>
              <div class="d-flex align-items-center mb-2">
                <span
                  class="badge <%= demande.statut === 'Validé' ? 'bg-success' : 'bg-dark' %> me-2"
                >
                  <%= demande.statut %>
                </span>
              </div>
              <div class="d-flex justify-content-end mt-3 gap-2">
                <% if(demande.statut !== 'Validé') { %>
                <a
                  href="/demandes/recruteur/valider/<%= demande.id %>"
                  class="btn btn-sm btn-success"
                  >Valider</a
                >
                <% } %>
                <a
                  href="/demandes/recruteur/voir/<%= demande.id %>"
                  class="btn btn-sm btn-outline-dark"
                  >Voir</a
                >
                <button
                class="btn btn-sm btn-outline-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModalDemande-<%= demande.id %>"
              >
                Refuser
              </button>
                <%- include('../partials/Confirmation', { 
                  modalId: "deleteModalDemande-" + demande.id,
                  message: "Êtes-vous sûr de vouloir refuser cette demande ?",
                  action: "/demandes/recruteur/refuser/" + demande.id
                }) %>
                
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <!-- Pagination -->
      <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a
              class="page-link text-dark"
              href="/GestionDemandeRecruteur?page=<%= currentPage-1 %>&search=<%= searchTerm %>"
              >&lt;</a
            >
          </li>

          <% for(let i = 1; i <= totalPages; i++) { %> <% if(i === 1 || i ===
          totalPages || (i >= currentPage-1 && i <= currentPage+1)) { %>
          <li class="page-item <%= i === currentPage ? 'active' : '' %>">
            <a
              class="page-link <%= i === currentPage ? 'bg-dark border-dark' : 'text-dark' %>"
              href="/GestionDemandeRecruteur?page=<%= i %>&search=<%= searchTerm %>"
              ><%= i %></a
            >
          </li>
          <% } else if(i === 2 && currentPage > 3) { %>
          <li class="page-item">
            <span class="page-link text-dark">...</span>
          </li>
          <% } else if(i === totalPages-1 && currentPage < totalPages-2) { %>
          <li class="page-item">
            <span class="page-link text-dark">...</span>
          </li>
          <% } %> <% } %>

          <li
            class="page-item <%= currentPage === totalPages || totalPages === 0 ? 'disabled' : '' %>"
          >
            <a
              class="page-link text-dark"
              href="/GestionDemandeRecruteur?page=<%= currentPage+1 %>&search=<%= searchTerm %>"
              >&gt;</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
