<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestion des Recruteurs</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container">
        <a class="navbar-brand" href="#">Accueil</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="#">Gestion utilisateurs</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">Gestion organisations</a>
            </li>
            <li class="nav-item">
              <a class="nav-link active" href="#">Gestion recruteurs</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <h2 class="mb-3">GESTION DES DEMANDES POUR DEVENIR RECRUTEUR</h2>
      <p class="text-muted">
        Vous pouvez visualiser toutes les demandes de comptes utilisateur pour
        rejoindre une organisation et devenir recruteur.
      </p>

      <div class="input-group mb-3">
        <input
          type="text"
          class="form-control"
          placeholder="Rechercher un utilisateur..."
        />
        <button class="btn btn-outline-secondary" type="button">
          Rechercher
        </button>
      </div>

      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Clé</h5>
          <p class="card-text">
            <strong>Nom :</strong> prénom<br />
            <strong>Statut :</strong> vœux d’organisation<br />
            <strong>Formulaire recruteur :</strong> disponible
          </p>
          <button class="btn btn-success me-2">Valider</button>
          <button class="btn btn-danger">Refuser</button>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Clé</h5>
          <p class="card-text">
            <strong>Nom :</strong> prénom<br />
            <strong>Statut :</strong> vœux d’organisation<br />
            <strong>Formulaire recruteur :</strong> disponible
          </p>
          <button class="btn btn-success me-2">Valider</button>
          <button class="btn btn-danger">Refuser</button>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
