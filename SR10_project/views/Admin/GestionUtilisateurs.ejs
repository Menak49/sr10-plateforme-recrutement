<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gestion des comptes utilisateurs</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-4">
      <h2 class="fw-bold">GESTION DES COMPTES UTILISATEURS</h2>

      <form method="GET" class="input-group mt-3 mb-3 shadow-sm">
        <input
          type="text"
          class="form-control"
          placeholder="Rechercher un utilisateur..."
          name="search"
          value="<%= searchTerm %>"
        />
        <button type="submit" class="btn btn-dark">🔍</button>
      </form>

      <div class="row g-3">
        <% utilisateurs.forEach(user => { %>
        <div class="col-md-4 mb-3">
          <div class="card border shadow-sm h-100">
            <div class="card-body">
              <h5 class="fw-bold mb-0"><%= user.nom %></h5>
              <p class="text-muted"><%= user.email %></p>
              <div class="d-flex justify-content-end mt-3 gap-2">
                <button class="btn btn-sm btn-dark">Éditer</button>
                <button class="btn btn-sm btn-outline-dark">Voir</button>
                <button
            class="btn btn-sm btn-outline-danger"
            data-bs-toggle="modal"
            data-bs-target="#deleteModalUser-<%= user.id %>"
          >
            Supprimer
          </button>

          <%- include('../partials/Confirmation', { 
            modalId: "deleteModalUser-" + user.id,
            message: "Êtes-vous sûr de vouloir supprimer l'utilisateur " + user.nom + " ?",
            action: "delete-user/" + user.id
          }) %>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
      
          <!-- Bouton précédent -->
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="?page=<%= currentPage - 1 %>&search=<%= searchTerm %>">&lt;</a>
          </li>
      
          <!-- Pages numérotées -->
          <% for(let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
              <a class="page-link <%= i === currentPage ? 'bg-dark border-dark text-white' : 'text-dark' %>" 
                 href="?page=<%= i %>&search=<%= searchTerm %>">
                 <%= i %>
              </a>
            </li>
          <% } %>
      
          <!-- Bouton suivant -->
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="?page=<%= currentPage + 1 %>&search=<%= searchTerm %>">&gt;</a>
          </li>
      
        </ul>
      </nav>
      
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
