<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Candidater à une offre</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark text-light">
  <%- include('../partials/navbar', { title: 'Candidater à une offre' }) %>
  <div class="container mt-4">
    <div class="card bg-light text-dark">
      <div class="card-body">
        <h4 class="card-title mb-4">CANDIDATER À L'OFFRE : <%= offre.TitreOffre %></h4>
        <form action="/candidat/candidater/<%= offre.Id %>" method="POST">
          <div class="mb-3">
            <label class="form-label">Offre</label>
            <input type="text" class="form-control" value="<%= offre.TitreOffre %>" disabled>
          </div>
          <div class="mb-3">
            <label class="form-label">Date de candidature</label>
            <input type="text" class="form-control" value="<%= defaultValues.date %>" disabled>
            <input type="hidden" name="date" value="<%= defaultValues.date %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Pièces à joindre pour constituer votre dossier :</label>
            <% pieces.forEach(piece => { %>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="pieces" value="<%= piece.Id %>" id="piece-<%= piece.Id %>">
                <label class="form-check-label" for="piece-<%= piece.Id %>">
                  <%= piece.Name %>
                </label>
              </div>
            <% }) %>
          </div>
          <div class="text-end">
            <a href="/candidat/parcourir" class="btn btn-secondary me-2">Annuler</a>
            <button type="submit" class="btn btn-dark">Candidater</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>