<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Candidater à une offre</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-dark text-light">
  <%- include('../partials/navbar', { title: 'Candidater à une offre' }) %>
  <div class="container mt-4">
    <div class="card bg-light text-dark">
      <div class="card-body">
        <h4 class="card-title mb-4">Pour candidatater à l'offre <%= offre.TitreOffre %>, veuillez joindre des pièces de dossier: </h4>
        <form action="/candidat/candidater/<%= offre.Id %>" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label"><b>Offre</b></label>
            <input type="text" class="form-control" value="<%= offre.TitreOffre %>" disabled>
          </div>
          <div class="mb-3">
            <label class="form-label"><b>Date de candidature</b></label>
            <input type="text" class="form-control" value="<%= defaultValues.date %>" disabled>
            <input type="hidden" name="date" value="<%= defaultValues.date %>">
          </div>
          <div class="mb-3">
            <div class="row">
              <div class="col-md-6">
                <% pieces.slice(0, 3).forEach(piece => { %>
                  <div class="mb-2">
                    <label class="form-label"><b><%= piece.Name %> :</b></label>
                    <input class="form-control" type="file" name="piece_<%= piece.Id %>">
                  </div>
                <% }) %>
              </div>
              <div class="col-md-6">
                <% pieces.slice(3, 6).forEach(piece => { %>
                  <div class="mb-2">
                    <label class="form-label"><b><%= piece.Name %> :</b></label>
                    <input class="form-control" type="file" name="piece_<%= piece.Id %>">
                  </div>
                <% }) %>
              </div>
            </div>
          </div>
          <div class="text-end">
            <a href="/candidat/parcourir" class="btn btn-secondary me-2">Annuler</a>
            <button type="submit" class="btn btn-dark">Candidater</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>