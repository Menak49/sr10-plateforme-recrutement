<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mes Candidatures</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <%- include('../partials/navbar', { title: 'Mes Candidatures' }) %>

    <div class="container mt-4">
      <h2 class="fw-bold mb-4">MES CANDIDATURES</h2>

      <% candidatures.forEach(c => { %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <p class="text-muted mb-1"><%= c.organisation %></p>

          <h5 class="fw-bold"><%= c.titre %></h5>

          <div class="d-flex flex-wrap mb-3">
            <div class="me-3"><small><%= c.localisation %></small></div>
            <div class="me-3">
              <small><%= c.contrat || 'Non spécifié' %></small>
            </div>
            <div><small>Candidature du <%= c.date_candidature %></small></div>
          </div>


          <div class="d-flex justify-content-end gap-2">
            <a href="#" class="btn btn-sm btn-outline-danger">Annuler</a>
            <a href="#" class="btn btn-sm btn-outline-secondary">Modifier</a>
          </div>

          <% if (c.pieces) { const docs = c.pieces.split('||'); %>
          <div class="mt-3">
            <p class="mb-1">
              <a
                class="text-decoration-none text-dark"
                data-bs-toggle="collapse"
                href="#pieces<%= c.candidature_id %>"
              >
                <small>Pièces jointes (<%= docs.length %>) ▾</small>
              </a>
            </p>
            <div class="collapse" id="pieces<%= c.candidature_id %>">
              <ul class="list-group list-group-flush mt-2 border">
                <% docs.forEach(doc => { const [name, path] = doc.split('::');
                %>
                <li
                  class="list-group-item d-flex justify-content-between align-items-center py-2"
                >
                  <small><%= name %></small>
                  <a
                    href="<%= path %>"
                    class="btn btn-sm btn-outline-dark"
                    download
                    >Télécharger</a
                  >
                </li>
                <% }) %>
              </ul>
            </div>
          </div>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>

    <% include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
