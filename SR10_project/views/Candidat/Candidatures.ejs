<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mes Candidatures</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <%- include('../partials/navbar', { title: 'Mes Candidatures' }) %>

    <div class="container mt-4">
      <h2 class="fw-bold mb-4">MES CANDIDATURES</h2>
      <form method="get" action="candidatures" class="mb-4 d-flex gap-2">
        <input type="text" name="search" placeholder="Recherche..." class="form-control" value="<%= searchTerm || '' %>">
        <button class="btn btn-dark" type="submit">🔍</button>
      </form>
      
      

      <% candidatures.forEach(c => { %>
      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <p class="text-muted mb-1"><%= c.organisation %></p>

          <h5 class="fw-bold"><%= c.titre %></h5>

          <div class="d-flex flex-wrap mb-3">
            <div class="me-3"><small><%= c.localisation %></small></div>
            <div class="me-3">
              <small><%= c.contrat || 'Non spécifié' %></small>
            </div>
            <div><small>Candidature du <%= c.date_candidature %></small></div>
          </div>


          <div class="d-flex justify-content-end gap-2">
                        <button 
              class="btn btn-sm btn-outline-danger" 
              data-bs-toggle="modal" 
              data-bs-target="#deleteModalCandidature-<%= c.candidature_id %>"
            >
              Annuler
            </button>
            <%- include('../partials/Confirmation', {
              modalId: "deleteModalCandidature-" + c.candidature_id,
              message: "Êtes-vous sûr de vouloir annuler cette candidature ?",
              action: "/candidat/delete-candidature/" + c.candidature_id
            }) %>
             </div>

          <% if (c.pieces) { const docs = c.pieces.split('||'); %>
          <div class="mt-3">
            <p class="mb-1">
              <a
                class="text-decoration-none text-dark"
                data-bs-toggle="collapse"
                href="#pieces<%= c.candidature_id %>"
              >
                <small>Pièces jointes (<%= docs.length %>) ▾</small>
              </a>
            </p>
            <div class="collapse" id="pieces<%= c.candidature_id %>">
              <ul class="list-group list-group-flush mt-2 border">
                <% docs.forEach(doc => { const [name, path] = doc.split('::');
                %>
                <li
                  class="list-group-item d-flex justify-content-between align-items-center py-2"
                >
                  <small><%= name %></small>
                  <a
                    href="<%='/'+ path %>"
                    class="btn btn-sm btn-outline-dark"
                    download
                    >Télécharger</a
                  >
                </li>
                <% }) %>
              </ul>
            </div>
          </div>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="?page=<%= currentPage - 1 %>&search=<%= searchTerm %>">‹</a>
          </li>
      
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link <%= currentPage === i ? 'bg-dark border-dark' : 'text-dark' %>" href="?page=<%= i %>&search=<%= searchTerm %>"><%= i %></a>
              </li>
            <% } else if ((i === 2 && currentPage > 3) || (i === totalPages - 1 && currentPage < totalPages - 2)) { %>
              <li class="page-item">
                <span class="page-link text-dark">…</span>
              </li>
            <% } %>
          <% } %>
      
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="gererFicheDePoste?page=<%= currentPage + 1 %>">›</a>
          </li>
        </ul>
      </nav>
      

    <% include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
