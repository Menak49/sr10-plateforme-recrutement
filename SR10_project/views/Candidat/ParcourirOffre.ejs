<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offres d'emploi</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-4">
      <h2 class="fw-bold">PARCOUREZ LES OFFRES</h2>

      <form method="GET" action="parcourir">
        <div class="input-group mt-3 mb-3 shadow-sm">
          <input
            type="text"
            class="form-control"
            placeholder="Rechercher par titre, organisation ou mots-clés"
            value="<%= searchTerm %>"
            name="search"
          />
          <button class="btn btn-dark">🔍</button>
        </div>
      </form>

      <button class="btn btn-outline-dark mb-4">Toutes les Offres</button>

      <div class="row g-3">
        <% offres.forEach(offre => { %>
        <div class="col-md-4">
          <div class="card border shadow-sm">
            <div class="card-body">
              <p class="text-muted mb-1"><%= offre.organisation %></p>
              <h5 class="fw-bold"><%= offre.titre %></h5>
              <p class="text-muted">
                <%= offre.contrat %> - <%= offre.localisation %>
              </p>
              <div class="d-flex justify-content-end gap-2">
                <a href="/candidat/candidater/<%= offre.id %>" class="btn btn-dark">Candidater</a>
<button 
  class="btn btn-sm btn-outline-success" 
  data-bs-toggle="modal" 
  data-bs-target="#afficherModal-<%= offre.id %>">
  Afficher
</button>                
<div class="modal fade" id="afficherModal-<%= offre.id %>" tabindex="-1" aria-labelledby="afficherModalLabel-<%= offre.id %>" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="afficherModalLabel-<%= offre.id %>">
          <%= offre.titre %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        <p><strong>Organisation :</strong> <%= offre.organisation %></p>
        <p><strong>Contrat :</strong> <%= offre.contrat %></p>
        <p><strong>Localisation :</strong> <%= offre.localisation %></p>
        <p><strong>Description :</strong> <%= offre.description %></p>
      </div>
      <div class="modal-footer">
        <a href="/candidat/postuler/<%= offre.id %>" class="btn btn-success">Candidater</a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
      </div>
    </div>
  </div>
</div>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="parcourir?page=<%= currentPage - 1 %>">‹</a>
          </li>

          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link <%= currentPage === i ? 'bg-dark border-dark' : 'text-dark' %>" href="parcourir?page=<%= i %>"><%= i %></a>
              </li>
            <% } else if ((i === 2 && currentPage > 3) || (i === totalPages - 1 && currentPage < totalPages - 2)) { %>
              <li class="page-item">
                <span class="page-link text-dark">…</span>
              </li>
            <% } %>
          <% } %>

          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="parcourir?page=<%= currentPage + 1 %>">›</a>
          </li>
        </ul>
      </nav>

      <% include('../partials/footer.ejs') %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
