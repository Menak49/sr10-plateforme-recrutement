<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Publier une offre</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-light">
    <%- include('../partials/navbar', { title: 'Publier une offre' }) %>

    <div class="container mt-4">
      <div class="card bg-light text-dark">
        <div class="card-body">
          <h4 class="card-title mb-4">PUBLIER UNE NOUVELLE OFFRE</h4>

          <form method="POST" action="/offres/ajouter">
            <!-- Fiche de poste -->
            <div class="mb-3">
              <label for="fichePosteId" class="form-label"
                >Fiche de poste</label
              >
              <select
                class="form-select form-select-sm"
                id="fichePosteId"
                name="fichePosteId"
                required
              >
                <option value="" disabled selected>Choisissez une fiche de poste</option>
                <% fiches.forEach(fiche => { %>
                
                  Choisissez une fiche de poste
                </option>

                <option value="<%= fiche.id %>">
                  <%= fiche.Title %> - <%= fiche.organisation %>
                </option>
                <% }) %>
              </select>
            </div>

            <!-- State -->
            <div class="mb-3">
              <label for="state" class="form-label">État de l'offre</label>
              <select
                class="form-select form-select-sm"
                id="state"
                name="state"
                required
              >
                <option value="brouillon">Brouillon</option>
                <option value="publiée">Publiée</option>
                <option value="fermée">Fermée</option>
              </select>
            </div>

            <!-- Expiry Date -->
            <div class="mb-3">
              <label for="expiryDate" class="form-label">Date limite</label>
              <input
                type="date"
                class="form-control form-control-sm"
                id="expiryDate"
                name="expiryDate"
                required
              />
            </div>

            <!-- Details -->
            <div class="mb-3">
              <label for="details" class="form-label"
                >Détails supplémentaires</label
              >
              <textarea
                class="form-control form-control-sm"
                id="details"
                name="details"
                rows="4"
                placeholder="Compléments d'information sur l'offre"
              ></textarea>
            </div>

            <!-- Slots -->
            <div class="mb-3">
              <label for="slots" class="form-label"
                >Nombre de postes ouverts</label
              >
              <input
                type="number"
                class="form-control form-control-sm"
                id="slots"
                name="slots"
                min="1"
                required
              />
            </div>

            <!-- Boutons -->
            <div class="text-end">
              <a href="/" class="btn btn-secondary me-2">Annuler</a>
              <button type="submit" class="btn btn-dark">
                Publier l'offre
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
