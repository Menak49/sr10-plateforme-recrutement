<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Candidatures reçues</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-4">
      <h2 class="fw-bold">CANDIDATURES REÇUES POUR L'OFFRE #<%= offreId %></h2>

      <% if (reponses.length === 0) { %>
        <div class="alert alert-info mt-4">Aucune candidature pour cette offre.</div>
      <% } %>

      <div class="row g-3">
        <% reponses.forEach(c => { %>
        <div class="col-md-4">
          <div class="card border shadow-sm">
            <div class="card-body">
              <p class="text-muted mb-1">
                <strong>Candidat :</strong> <%= c.nom %> <%= c.prenom %> (<%= c.email %>)
              </p>
              <p class="mb-1">
                <strong>Date de candidature :</strong> <%= c.date_candidature %>
              </p>
              <% if (c.pieces) { 
                const docs = c.pieces.split('||'); %>
                <div class="mt-2">
                  <a
                    class="text-decoration-none text-dark"
                    data-bs-toggle="collapse"
                    href="#pieces<%= c.candidature_id %>"
                  >
                    <small>Pièces jointes (<%= docs.length %>) ▾</small>
                  </a>
                  <div class="collapse" id="pieces<%= c.candidature_id %>">
                    <ul class="list-group list-group-flush mt-2 border">
                      <% docs.forEach(doc => {
                        const [name, chemin] = doc.split('::');
                        if (name && chemin) { %>
                          <li class="list-group-item bg-light">
                            <a href="<%='/'+ chemin %>" target="_blank"><%= name %></a>
                          </li>
                        <% }
                      }); %>
                    </ul>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>