<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fiches de Poste</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-4">
      <h2 class="fw-bold">PARCOUREZ LES FICHES DE POSTE</h2>

      <div class="input-group mt-3 mb-3 shadow-sm">
        <input
          type="text"
          class="form-control"
          placeholder="Rechercher par titre, entreprise ou mots-clés"
        />
        <button class="btn btn-dark">🔍</button>
      </div>

      <button class="btn btn-outline-dark mb-4">Toutes les Fiches</button>
      <a href="ajouterFicheDePoste">
        <button class="btn btn-outline-dark mb-4">
          Ajouter une nouvelle fiche
        </button>
      </a>
      <div class="row g-3">
        <% fiches.forEach(fiche => { %>
        <div class="col-md-4">
          <div class="card border shadow-sm">
            <div class="card-body">
              <p class="text-muted mb-1"><%= fiche.organisation %></p>
              <h5 class="fw-bold"><%= fiche.titre %></h5>
              <p class="text-muted">
                <%= fiche.statut %> - <%= fiche.localisation %>
              </p>
              <p class="text-muted">
                <%= fiche.minSalaire %>€ - <%= fiche.maxSalaire %>€ / semaine
              </p>
              <div class="d-flex justify-content-end gap-2">
                <a href="/fiches/<%= fiche.id %>" class="btn btn-dark"
                  >Afficher</a
                >
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item">
            <a class="page-link text-dark" href="#">‹</a>
          </li>
          <li class="page-item active">
            <a class="page-link bg-dark border-dark" href="#">1</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">2</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">3</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">…</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">9</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">›</a>
          </li>
        </ul>
      </nav>
    </div>
    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
