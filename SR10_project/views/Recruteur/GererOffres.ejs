<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gérer les Offres d'Emploi</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-4">
      <h2 class="fw-bold">GÉRER LES OFFRES D'EMPLOI</h2>

      <form method="GET" action="gererOffres">
        <div class="input-group mt-3 mb-3 shadow-sm">
          <input
            type="text"
            class="form-control"
            placeholder="Rechercher par titre, organisation ou mots-clés"
            value="<%= searchTerm %>"
            name="search"
          />
          <button class="btn btn-dark">🔍</button>
        </div>
      </form>
      
      
      <a href="ajouterOffre">
        <button class="btn btn-outline-success mb-4"> 
          Ajouter une nouvelle offre 
        </button>
      </a>

      <div class="row g-3">
        <% offres.forEach(offre => { %>
        <div class="col-md-4">
          <div class="card border shadow-sm">
            <div class="card-body">
              <p class="text-muted mb-1"><%= offre.organisation %></p>
              <h5 class="fw-bold"><%= offre.titre %></h5>
              <p class="text-muted">
                <%= offre.etat %> - <%= offre.localisation %>
              </p>
              <p class="text-muted">
                <%= offre.minSalaire %>€ - <%= offre.maxSalaire %>€ / semaine
              </p>
              <div class="d-flex justify-content-end gap-2">
                <a href="/supprimerOffre/<%= offre.id %>" class="btn btn-outline-danger">Supprimer</a>

                <a href="modifierOffre/<%= offre.id %>" class="btn btn-outline-secondary">Modifier</a>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="gererFicheDePoste?page=<%= currentPage - 1 %>">‹</a>
          </li>
      
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link <%= currentPage === i ? 'bg-dark border-dark' : 'text-dark' %>" href="gererFicheDePoste?page=<%= i %>"><%= i %></a>
              </li>
            <% } else if ((i === 2 && currentPage > 3) || (i === totalPages - 1 && currentPage < totalPages - 2)) { %>
              <li class="page-item">
                <span class="page-link text-dark">…</span>
              </li>
            <% } %>
          <% } %>
      
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link text-dark" href="gererFicheDePoste?page=<%= currentPage + 1 %>">›</a>
          </li>
        </ul>
      </nav>
      
    </div>
    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
