<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Formulaire Recruteur</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-white d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container py-5 flex-grow-1">
      <h2 class="fw-bold">FORMULAIRE RECRUTEUR</h2>

      <div class="d-flex align-items-center text-muted mb-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          fill="currentColor"
          class="bi bi-info-circle me-2"
          viewBox="0 0 16 16"
        >
          <path
            d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16z"
          />
          <path
            d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 .875-.252 1.02-.598l.088-.416c.066-.308.118-.437.288-.469l.451-.083.082-.38-1.293-.287.738-3.468zM8 5.5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1z"
          />
        </svg>
        <small
          >Un administrateur validera ou non votre demande. Vous recevrez un
          mail de confirmation.</small
        >
      </div>

      <form
        method="POST"
         action="/candidat/EnvoyerDemandeRecruteur" 
      >
        <div class="mb-3">
          <label for="organisation" class="form-label"
            >Nom de l'organisation que vous souhaitez rejoindre</label
          >
          <select
            class="form-select bg-dark text-white border-secondary"
            id="organisation"
            name="organisation"
          >
            <% if (organisations && organisations.length > 0) { %>
            <option value="" selected disabled>Choisir une organisation</option>
            <% organisations.forEach(org => { %>
            <option value="<%= org.Siren %>"><%= org.Name %></option>
            <% }) %> <% } else { %>
            <option disabled>Aucune organisation disponible</option>
            <% } %>
          </select>
        </div>

        <div class="mb-3">
          <label for="responsabilite" class="form-label"
            >Votre responsabilité dans l'organisation</label
          >
          <input
            type="text"
            class="form-control bg-dark text-white border-secondary"
            id="responsabilite"
            name="responsabilite"
            placeholder="ex: RH, manager..."
          />
        </div>

        <div class="mb-4">
          <label for="contrat" class="form-label">Contrat de travail</label>
          <input
            type="file"
            class="form-control bg-dark text-white border-secondary"
            id="contrat"
            name="contrat"
          />
        </div>

        <div class="d-flex gap-2">
          <a href="/candidat/privileges" class="btn btn-outline-light">Annuler</a>
          <button type="submit" class="btn btn-light text-dark">Envoyer</button>
        </div>
      </form>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
