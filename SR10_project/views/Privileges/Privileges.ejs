<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Élévation de Privilèges</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-white">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container mt-5">
      <h1 class="mb-4">ÉLÉVATION DE PRIVILÈGES</h1>

      <div class="mb-4">
        <p class="text-light">
          <i class="me-2 align-middle">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="bi bi-info-circle-fill"
              viewBox="0 0 16 16"
            >
              <path
                d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"
              />
            </svg>
          </i>
          <!-- On s'occupera plus tard (en fonction des privilige du client connecté) d'afficher ce qu'il exactement ce qu'il lui faut) -->
          <% if (roles.includes('recruteur') && roles.includes('admin')) { %> Vous n'avez pas encore de compte
          administrateur ou recruteur. Pour pouvoir faire la demande, un mail de
          confirmation vous sera envoyé. Vous pourrez également créer une
          organisation, un compte recruteur doit être rattaché à une
          organisation. <% } else if (role === 'recruteur') { %> En tant que
          recruteur, vous pouvez demander des privilèges administrateur ou créer
          une nouvelle organisation. <% } else if (role === 'admin') { %> En
          tant qu'administrateur, vous pouvez créer une nouvelle organisation ou
          devenir recruteur si nécessaire. <% } %>
        </p>
      </div>

      <div class="row">
  <% if (!roles.includes('admin')) { %>
  <div class="col-md-6 mb-4">
    <div class="card bg-dark text-white border border-secondary">
      <div class="card-body">
        <h5 class="card-title mb-3">Devenir administrateur</h5>
        <p class="card-text text-light">Gérer le back-office</p>
        <a href="devenirAdmin" class="btn btn-outline-light w-75 me-2">
          Demander
        </a>
      </div>
    </div>
  </div>
  <% } %>

  <% if (!roles.includes('recruteur')) { %>
  <div class="col-md-6 mb-4">
    <div class="card bg-dark text-white border border-secondary">
      <div class="card-body">
        <h5 class="card-title mb-3">Devenir recruteur</h5>
        <p class="card-text text-light">Gérer le formulaire recruteur</p>
        <div class="d-flex justify-content-between">
          <a
            href="devenirRecruteur"
            class="btn btn-outline-light w-75 me-2"
          >
            Demander
          </a>
          <button class="btn btn-outline-light">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="bi bi-download"
              viewBox="0 0 16 16"
            >
              <path
                d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"
              />
              <path
                d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <div class="col-md-6 mb-4">
    <div class="card bg-dark text-white border border-secondary">
      <div class="card-body">
        <h5 class="card-title mb-3">Créer une organisation</h5>
        <p class="card-text text-light">
          Remplir le formulaire d'organisation
        </p>
        <div class="d-flex justify-content-between">
          <a
            href="creerOrganisation"
            class="btn btn-outline-light w-75 me-2"
          >
            Demander
          </a>
          <button class="btn btn-outline-light">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              fill="currentColor"
              class="bi bi-download"
              viewBox="0 0 16 16"
            >
              <path
                d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"
              />
              <path
                d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

      

      <% include('../partials/footer') %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
