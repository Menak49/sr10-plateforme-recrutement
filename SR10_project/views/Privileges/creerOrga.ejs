<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Formulaire Création Organisation</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-white d-flex flex-column min-vh-100">
    <%- include('../partials/navbar', { role: role }) %>

    <div class="container py-5 flex-grow-1">
      <h2 class="fw-bold">FORMULAIRE ORGANISATION</h2>

      <div class="d-flex align-items-center text-muted mb-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          fill="currentColor"
          class="bi bi-info-circle me-2"
          viewBox="0 0 16 16"
        >
          <path
            d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16z"
          />
          <path
            d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 .875-.252 1.02-.598l.088-.416c.066-.308.118-.437.288-.469l.451-.083.082-.38-1.293-.287.738-3.468zM8 5.5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1z"
          />
        </svg>
        <small
          >Un administrateur validera ou non votre demande. Vous recevrez un
          mail de confirmation.</small
        >
      </div>

      <form
        method="POST"
        action="/organisation/creer"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="nom" class="form-label"
            >Nom de l'organisation pour laquelle vous travaillez</label
          >
          <input
            type="text"
            class="form-control bg-dark text-white border-secondary"
            id="nom"
            name="nom"
            required
          />
        </div>

        <div class="mb-3">
          <label for="siret" class="form-label">Siret</label>
          <input
            type="text"
            class="form-control bg-dark text-white border-secondary"
            id="siret"
            name="siret"
            required
          />
        </div>

        <div class="mb-3">
          <label for="type" class="form-label"
            >Type (association, SARL, SAS, etc.)</label
          >
          <input
            type="text"
            class="form-control bg-dark text-white border-secondary"
            id="type"
            name="type"
            placeholder="Association, SARL, SAS, etc."
            required
          />
        </div>

        <div class="mb-3">
          <label for="statut" class="form-label"
            >Siège social (adresse administrative)</label
          >
          <input
            type="text"
            class="form-control bg-dark text-white border-secondary"
            id="siege"
            name="siege"
            required
          />
        </div>

        <div class="d-flex gap-2">
          <a href="/" class="btn btn-outline-light">annuler</a>
          <button type="submit" class="btn btn-light text-dark">envoyer</button>
        </div>
      </form>
    </div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
