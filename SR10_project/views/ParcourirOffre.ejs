<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offres d'emploi</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-light">
    <nav
      class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm"
    >
      <div class="container">
        <a class="navbar-brand fw-bold" href="#">Accueil</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link fw-bold active" href="#">Offres</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">Organisations</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="#">Mes Candidatures</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mt-4">
      <h2 class="fw-bold">PARCOUREZ LES OFFRES</h2>

      <!-- Barre de recherche -->
      <div class="input-group mt-3 mb-3 shadow-sm">
        <input
          type="text"
          class="form-control"
          placeholder="Rechercher par offre, entreprise ou mots-clés"
        />
        <button class="btn btn-dark">🔍</button>
      </div>

      <button class="btn btn-outline-dark mb-4">Tous les Offres</button>

      <!-- Grille  avec toutes les offres dedans  -->
      <div class="row g-3">
        <% offres.forEach(offre => { %>
        <div class="col-md-4">
          <div class="card border shadow-sm">
            <div class="card-body">
              <p class="text-muted mb-1"><%= offre.organisation %></p>
              <h5 class="fw-bold"><%= offre.titre %></h5>
              <p class="text-muted">
                <%= offre.contrat %> - <%= offre.localisation %>
              </p>
              <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-dark">Candidater</button>
                <button class="btn btn-dark">Afficher</button>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <nav aria-label="Pagination" class="mt-4">
        <ul class="pagination justify-content-center">
          <li class="page-item">
            <a class="page-link text-dark" href="#">‹</a>
          </li>
          <li class="page-item active">
            <a class="page-link bg-dark border-dark" href="#">1</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">2</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">3</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">…</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">9</a>
          </li>
          <li class="page-item">
            <a class="page-link text-dark" href="#">›</a>
          </li>
        </ul>
      </nav>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
