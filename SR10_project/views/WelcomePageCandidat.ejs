<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-dark text-white text-center">
    <%- include('partials/navbar') %>
    <div
      class="container d-flex flex-column justify-content-center align-items-center vh-100 mx-auto"
    >
      <%= text%>
      <h1 class="text-center">
        Bienvenue sur votre <br />
        espace <span class="fw-monospace">Candidat</span>
      </h1>
      <a href="ParcourirOffre.html"
        ><button class="btn btn-light mt-4 fw-bold px-4 py-2 rounded">
          Chercher une offre
        </button></a
      >
    </div>

    <div class="position-fixed bottom-0 end-0 m-4 d-flex flex-column gap-2">
      <a href="WelcomePageRecruteur.html"
        ><button type="button" class="btn btn-dark">Espace Recruteur</button></a
      >

      <a href="WelcomePageAdmin.html"
        ><button type="button" class="btn btn-dark">Espace Admin</button></a
      >
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/footer') %>
  </body>
</html>
